# Copy to .env.narrator for local use. Do not commit real keys.

# mock | openai-compatible | openrouter | anthropic | ollama
NARRATOR_PROVIDER=mock

# Live providers need a model. Beacon can also send a model value from the UI.
NARRATOR_MODEL=

# OpenAI-compatible providers:
# NARRATOR_API_KEY=
# OPENAI_API_KEY=
# NARRATOR_BASE_URL=https://api.openai.com/v1

# OpenRouter:
# NARRATOR_PROVIDER=openai-compatible
# NARRATOR_BASE_URL=https://openrouter.ai/api/v1
# NARRATOR_API_KEY=
# OPENROUTER_SITE_URL=http://127.0.0.1:5174
# OPENROUTER_APP_TITLE=Student Body Local Prototype

# Anthropic:
# ANTHROPIC_API_KEY=
# NARRATOR_BASE_URL=https://api.anthropic.com

# Ollama:
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional tuning:
NARRATOR_PORT=8787
NARRATOR_TEMPERATURE=0.8
NARRATOR_MAX_TOKENS=900
